{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "krosa-maja",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "KROSA_MAJA_BASE_URL": "https://auth.denied.se"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "krosa-maja-auth",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "auth.denied.se",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  }
}
