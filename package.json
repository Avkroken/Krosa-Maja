{
  "name": "krosa-maja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm test && npm run typecheck && npm run validate:worker",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "generate:auth-schema": "npx auth@1.7.5 generate --config ./scripts/auth-cli.ts --output ./migrations/0001-better-auth.sql --yes",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:worker": "node --experimental-strip-types scripts/validate-worker.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.5",
    "better-auth": "1.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "4.131.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
