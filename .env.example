# Exempel endast. Lägg aldrig riktiga hemligheter i Git.
KROSA_MAJA_BASE_URL=https://auth.denied.se
KROSA_MAJA_SECRET=replace-with-at-least-32-random-characters
KROSA_MAJA_INTERNAL_ADMIN_SECRET=replace-with-an-independent-random-secret
KROSA_MAJA_GITHUB_CLIENT_ID=replace
KROSA_MAJA_GITHUB_CLIENT_SECRET=replace
KROSA_MAJA_ALLOWED_GITHUB_IDS=123456
KROSA_MAJA_ADMIN_GITHUB_IDS=123456
KROSA_MAJA_CLOUDFLARE_CLIENT_ID=replace
KROSA_MAJA_CLOUDFLARE_CLIENT_SECRET=replace
KROSA_MAJA_CLOUDFLARE_SCOPES=offline_access
