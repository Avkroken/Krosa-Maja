{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krosa-maja",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "KROSA_MAJA_SECRET",
      "KROSA_MAJA_INTERNAL_ADMIN_SECRET",
      "KROSA_MAJA_GITHUB_CLIENT_SECRET",
      "KROSA_MAJA_CLOUDFLARE_CLIENT_SECRET"
    ]
  },
  "vars": {
    "KROSA_MAJA_BASE_URL": "https://auth.denied.se",
    "KROSA_MAJA_GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_CLIENT_ID",
    "KROSA_MAJA_ALLOWED_GITHUB_IDS": "REPLACE_WITH_ALLOWED_NUMERIC_IDS",
    "KROSA_MAJA_ADMIN_GITHUB_IDS": "REPLACE_WITH_ADMIN_NUMERIC_IDS",
    "KROSA_MAJA_CLOUDFLARE_CLIENT_ID": "REPLACE_AFTER_CLOUDFLARE_OAUTH_CLIENT_EXISTS",
    "KROSA_MAJA_CLOUDFLARE_SCOPES": "offline_access"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "krosa-maja-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "routes": [
    {
      "pattern": "auth.denied.se",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  }
}
